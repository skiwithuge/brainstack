# ── Telegram Configuration ───────────────────────────────────────────────────
# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Your numerical Telegram User ID (keeps the bot strictly private)
AUTHORIZED_USER_ID="123456789" 

# ── LLM Configuration ────────────────────────────────────────────────────────
# Use "ollama" for self-hosted inference, or "gemini" for Google's API fallback
LLM_PROVIDER=ollama
# The model tag (e.g., mistral-nemo, llama3.1, or gemini-2.5-flash)
LLM_MODEL=mistral-nemo
# The Ollama API endpoint (required if LLM_PROVIDER=ollama)
LLM_BASE_URL=http://localhost:11434/api/generate
# Required if LLM_PROVIDER=gemini
GEMINI_API_KEY="your_api_key_here"

# ── Audio Transcription (Whisper) ───────────────────────────────────────────
# Options: tiny, base, small, medium, large-v3-turbo (default: small)
# With 8GB+ RAM, use "medium" for better Italian/complex audio.
# WHISPER_MODEL_SIZE="medium"

# ── Storage & Language ──────────────────────────────────────────────────────
# Where your notes and knowledge graph will be stored
NOTES_DIR="./Notes"
# Set to "it" for Italian prompts and UI, or "en" for English
APP_LANGUAGE="en"

# ── Web Viewer Security ─────────────────────────────────────────────────────
# Password for the browser dashboard
WEB_PASSWORD="brainstack"
