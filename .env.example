# Telegram Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Your numerical Telegram User ID (keeps the bot strictly private)
AUTHORIZED_USER_ID="123456789" 

# ── LLM Configuration ────────────────────────────────────────────────────────
# Use "ollama" for self-hosted LXC inference, or "gemini" for Google's API fallback
LLM_PROVIDER=ollama
# The model tag (e.g., mistral-nemo, llama3.1, or gemini-2.5-flash)
LLM_MODEL=mistral-nemo
# The Ollama API endpoint (if using LLM_PROVIDER=ollama)
LLM_BASE_URL=http://<LXC_IP>:11434/api/generate
GEMINI_API_KEY="your_api_key_here"

# File System (Where your notes will be stored)
NOTES_DIR="./Notes"

# Whisper Audio Transcription Model Size
# Defaults to "small" for better accuracy on N100 servers.
# Since you have 8GB RAM, you can uncomment and set this to "medium" or "large-v3-turbo"
# for significantly better Italian transcription (at the cost of slightly slower processing time).
# WHISPER_MODEL_SIZE="medium"

# Web Viewer Configuration
WEB_PASSWORD="brainstack"

# i18n
APP_LANGUAGE="en"
